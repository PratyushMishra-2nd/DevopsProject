# Copy to terraform.tfvars (git-ignored). No AWS credentials belong here:
# Terraform reads them from your AWS CLI profile / environment.

aws_region        = "ap-south-1"
availability_zone = "ap-south-1a"
instance_type     = "t3.micro" # free-tier eligible everywhere; m7i-flex.large if your account allows it
root_volume_gb    = 30

# Your public IP (curl https://checkip.amazonaws.com).
admin_cidrs = ["203.0.113.10/32"]
# web_cidrs = ["0.0.0.0/0"]   # only while someone else needs to open the app

ssh_public_key = "ssh-ed25519 AAAA... you@laptop"
