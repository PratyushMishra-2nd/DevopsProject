# Copy to terraform.tfvars (git-ignored) and adjust. No credentials belong here:
# Terraform reads AWS credentials from your AWS CLI profile / environment.

aws_region         = "ap-south-1"
project            = "pantrypulse"
environment        = "demo"
availability_zones = ["ap-south-1a", "ap-south-1b"]

# Your public IP (curl https://checkip.amazonaws.com) - the EKS API is not opened to the world.
api_allowed_cidrs = ["203.0.113.10/32"]

kubernetes_version  = "1.35"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3

# Cost switches: NAT gateway, CloudWatch control-plane logs and a KMS key all
# add hourly/monthly charges, so they are off for the short-lived demo.
enable_nat_gateway        = false
enable_control_plane_logs = false
enable_secrets_encryption = false
